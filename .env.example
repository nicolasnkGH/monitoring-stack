# Required
DOMAIN=your.domain.com

# Optional
NAS_LOG_PATH=/var/log/grafana
GRAFANA_PASSWORD=change-me

# ============================================================================
# Alertmanager - Email Notifications
# ============================================================================
# SMTP configuration for alert notifications
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_FROM=alerts@your.domain.com
SMTP_USERNAME=your-email@yourprovider.com
SMTP_PASSWORD=your-smtp-password
SMTP_TO=your-email@example.com

# ============================================================================
# Alertmanager - Telegram Notifications
# ============================================================================
# Create a bot via @BotFather on Telegram, get BOT_TOKEN and CHAT_ID
# CHAT_ID can be found by sending a message to your bot and checking
# https://api.telegram.org/bot<BOT_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ============================================================================
# Alertmanager - Email Fallback (optional, for critical alerts only)
# ============================================================================
# Enable email-only fallback for critical alerts
# EMAIL_FALLBACK_ENABLED=false