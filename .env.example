# ============================================================================
# monitoring-stack Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# NEVER commit .env to version control!
# ============================================================================

# --- Domain Configuration ---
# Your base domain for accessing services via reverse proxy
DOMAIN=your-domain.com

# --- Grafana Configuration ---
# Strong password for the Grafana admin user (admin/admin)
GRAFANA_PASSWORD=change-me-secure-password

# --- Storage Configuration ---
# Path to NAS mount for long-term log/Grafana persistence
# On Raspberry Pi, this would be something like:
# NAS_LOG_PATH=/mnt/nas/monitoring/grafana_logs
NAS_LOG_PATH=/mnt/monitoring/grafana

# --- SSH Configuration (for CI/CD deployment) ---
# GitHub Secrets — these are set in repository settings, NOT here
# SSH_PRIVATE_KEY: Contents of your SSH private key (ed25519 recommended)
# SSH_HOST: IP or hostname of your Raspberry Pi
# SSH_USERNAME: Username on the Raspberry Pi

# --- Backup Configuration (optional overrides) ---
# PROMETHEUS_URL: URL for Prometheus Admin API
PROMETHEUS_URL=http://localhost:9090
# BACKUP_DIR: Where to store backup snapshots
BACKUP_DIR=/mnt/monitoring/backups/prometheus
# SNAPSHOTS_TO_KEEP: Number of days to retain backups
SNAPSHOTS_TO_KEEP=7